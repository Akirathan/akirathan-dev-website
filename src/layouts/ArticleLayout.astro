---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  meta?: string;
  backHref: string;
  backLabel: string;
}

const { title, description, eyebrow, meta, backHref, backLabel } = Astro.props;
---

<BaseLayout title={`${title} · Pavel Marek`} description={description}>
  <article class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6 sm:py-16">
    <a
      href={backHref}
      data-nav="back"
      class="text-sm text-muted transition-colors hover:text-accent"
    >
      ← {backLabel}
    </a>
    <header class="mt-6 mb-10">
      {eyebrow && (
        <p class="text-xs font-medium tracking-widest text-accent uppercase">{eyebrow}</p>
      )}
      <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">{title}</h1>
      {meta && <p class="mt-3 text-muted">{meta}</p>}
      <slot name="header" />
    </header>
    <div class="prose prose-invert prose-headings:font-heading prose-headings:tracking-tight prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-blockquote:border-accent-dim prose-blockquote:text-muted prose-code:before:content-none prose-code:after:content-none max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
