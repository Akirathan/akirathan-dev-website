---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Outline from '../components/Outline.astro';
import { REFERENCES_ID } from '../markdown/externalLinks';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  meta?: string;
  /** Shown next to the title (a logo, for example). */
  icon?: ImageMetadata;
  backHref: string;
  backLabel: string;
  /** `view-transition-name` prefix: the icon and the title morph from the page that links here. */
  transitionName?: string;
  /** Headings of the article body. The `h2` ones form the outline, when there are two or more. */
  headings?: MarkdownHeading[];
}

const {
  title,
  description,
  eyebrow,
  meta,
  icon,
  backHref,
  backLabel,
  transitionName,
  headings = [],
} = Astro.props;
const sections = headings.filter((h) => h.depth === 2 && h.slug !== REFERENCES_ID);
const hasOutline = sections.length >= 2;
const morph = (part: string) =>
  transitionName ? `view-transition-name: ${transitionName}-${part}` : undefined;
---

<BaseLayout title={`${title} · Pavel Marek`} description={description}>
  <div
    class:list={[
      'w-full',
      // The outline takes the left gutter. The article stays centred while the gutter is wide
      // enough, and moves to the right on narrower screens.
      hasOutline && 'lg:grid lg:grid-cols-[minmax(17rem,1fr)_minmax(0,48rem)_minmax(0,1fr)]',
    ]}
  >
    {hasOutline && (
      <aside class="hidden lg:block">
        <div class="sticky top-0 flex h-dvh items-center justify-end pr-2 pl-4">
          <Outline headings={sections} />
        </div>
      </aside>
    )}
    <article class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6 sm:py-16 lg:col-start-2">
      <a
        href={backHref}
        data-nav="back"
        class="text-sm text-muted transition-colors hover:text-accent"
      >
        ← {backLabel}
      </a>
      <header class="mt-6 mb-10">
        {eyebrow && (
          <p class="text-xs font-medium tracking-widest text-accent uppercase">{eyebrow}</p>
        )}
        <div class="mt-2 flex items-center gap-4">
          {icon && (
            <Image
              src={icon}
              alt=""
              width={128}
              height={128}
              class="size-12 sm:size-16"
              style={morph('icon')}
            />
          )}
          <h1 class="text-4xl font-bold tracking-tight sm:text-5xl" style={morph('title')}>
            {title}
          </h1>
        </div>
        {meta && <p class="mt-3 text-muted">{meta}</p>}
        <slot name="header" />
      </header>
      <div class="prose prose-invert prose-headings:font-heading prose-headings:tracking-tight prose-a:text-accent prose-a:no-underline prose-a:hover:underline prose-blockquote:border-accent-dim prose-blockquote:text-muted prose-code:before:content-none prose-code:after:content-none max-w-none">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>
