---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  meta?: string;
  /** Shown next to the title (a logo, for example). */
  icon?: ImageMetadata;
  backHref: string;
  backLabel: string;
  /** `view-transition-name` prefix: the icon and the title morph from the page that links here. */
  transitionName?: string;
}

const { title, description, eyebrow, meta, icon, backHref, backLabel, transitionName } =
  Astro.props;
const morph = (part: string) =>
  transitionName ? `view-transition-name: ${transitionName}-${part}` : undefined;
---

<BaseLayout title={`${title} · Pavel Marek`} description={description}>
  <article class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6 sm:py-16">
    <a
      href={backHref}
      data-nav="back"
      class="text-sm text-muted transition-colors hover:text-accent"
    >
      ← {backLabel}
    </a>
    <header class="mt-6 mb-10">
      {eyebrow && (
        <p class="text-xs font-medium tracking-widest text-accent uppercase">{eyebrow}</p>
      )}
      <div class="mt-2 flex items-center gap-4">
        {icon && (
          <Image
            src={icon}
            alt=""
            width={128}
            height={128}
            class="size-12 sm:size-16"
            style={morph('icon')}
          />
        )}
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl" style={morph('title')}>
          {title}
        </h1>
      </div>
      {meta && <p class="mt-3 text-muted">{meta}</p>}
      <slot name="header" />
    </header>
    <div class="prose prose-invert prose-headings:font-heading prose-headings:tracking-tight prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-blockquote:border-accent-dim prose-blockquote:text-muted prose-code:before:content-none prose-code:after:content-none max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
