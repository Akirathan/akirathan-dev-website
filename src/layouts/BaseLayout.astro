---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Background from '../components/Background.astro';
import { ClientRouter } from 'astro:transitions';
import { getImage } from 'astro:assets';
import portrait from '../assets/portrait.jpg';

interface Props {
  title?: string;
  description?: string;
  /** Full wire background with pulses, for the landing page. Other pages get the quiet one. */
  animatedBackground?: boolean;
}

const {
  title = 'Pavel Marek',
  description = 'Senior software engineer: compilers, runtimes, the JVM and GraalVM. Co-founder & CTO of Lístky radosti.',
  animatedBackground = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// Social preview: the portrait, square, as link previews expect.
const ogImage = await getImage({ src: portrait, width: 1200, height: 1200, fit: 'cover' });
const ogImageUrl = new URL(ogImage.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary" />
    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col" data-background={animatedBackground ? 'full' : 'quiet'}>
    <Background />
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
