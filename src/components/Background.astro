---
/**
 * Fixed full-page background. A CSS gradient is always present; the Three.js wires are
 * layered on top once they have loaded, and only when the browser can run them.
 *
 * `quiet` is for reading pages: the same wires and the pointer spotlight, but no pulses.
 */
interface Props {
  quiet?: boolean;
}
const { quiet = false } = Astro.props;
---

<div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--color-ink-soft),_var(--color-ink)_60%)]"></div>
  <canvas
    data-wires
    data-quiet={quiet ? '' : undefined}
    class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-1000 data-ready:opacity-100"
  ></canvas>
</div>

<script>
  import type { WiresHandle } from '../gfx/wires';

  const canRender = () =>
    'gpu' in navigator || !!document.createElement('canvas').getContext('webgl2');

  let handle: WiresHandle | null = null;

  // With client-side navigation this script runs once, so start per page and clean up
  // before each swap.
  const start = async () => {
    const canvas = document.querySelector<HTMLCanvasElement>('canvas[data-wires]');
    if (!canvas || !canRender()) return;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    try {
      const [{ startWires }, { themeColorHex }] = await Promise.all([
        import('../gfx/wires'),
        import('../gfx/cssColor'),
      ]);
      const accent = themeColorHex('--color-accent', '#a9d5b5');
      const pulses = canvas.dataset.quiet === undefined;
      handle = await startWires(canvas, { reducedMotion, accent, pulses });
      canvas.dataset.ready = '';
    } catch (error) {
      // The gradient stays. Nothing else to do.
      console.warn('Wire background disabled:', error);
    }
  };

  const schedule = () => {
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(() => void start(), { timeout: 1500 });
    } else {
      setTimeout(() => void start(), 300);
    }
  };

  document.addEventListener('astro:page-load', schedule);
  document.addEventListener('astro:before-swap', () => {
    handle?.dispose();
    handle = null;
  });
</script>
