---
/**
 * Fixed full-page background. A CSS gradient is always present; the Three.js starfield is
 * layered on top once it has loaded, and only when the browser can run it.
 */
---

<div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--color-ink-soft),_var(--color-ink)_60%)]"></div>
  <canvas
    data-starfield
    class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-1000 data-ready:opacity-100"
  ></canvas>
</div>

<script>
  import type { StarfieldHandle } from '../gfx/starfield';

  const canRender = () =>
    'gpu' in navigator || !!document.createElement('canvas').getContext('webgl2');

  let handle: StarfieldHandle | null = null;

  // With client-side navigation this script runs once, so start per page and clean up
  // before each swap.
  const start = async () => {
    const canvas = document.querySelector<HTMLCanvasElement>('canvas[data-starfield]');
    if (!canvas || !canRender()) return;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    try {
      const { startStarfield } = await import('../gfx/starfield');
      handle = await startStarfield(canvas, { reducedMotion });
      canvas.dataset.ready = '';
    } catch (error) {
      // The gradient stays. Nothing else to do.
      console.warn('Starfield disabled:', error);
    }
  };

  const schedule = () => {
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(() => void start(), { timeout: 1500 });
    } else {
      setTimeout(() => void start(), 300);
    }
  };

  document.addEventListener('astro:page-load', schedule);
  document.addEventListener('astro:before-swap', () => {
    handle?.dispose();
    handle = null;
  });
</script>
