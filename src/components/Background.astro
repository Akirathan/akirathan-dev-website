---
/**
 * Fixed full-page background. A CSS gradient is always present; the Three.js wires are layered
 * on top once they have loaded, and only when the browser can run them.
 *
 * The canvas persists across client-side navigation, so the wires never restart. The page says
 * which mode it wants through `data-background` on <body>: "full" runs the resting pulses,
 * "quiet" (reading pages) keeps only the lanes and the pointer spotlight. Every navigation plays
 * the burst, centred on the last click, or on the link that was activated.
 */
---

<div
  transition:persist="wires"
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 -z-10 overflow-hidden"
>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--color-ink-soft),_var(--color-ink)_60%)]"></div>
  <canvas
    data-wires
    class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-1000 data-ready:opacity-100"
  ></canvas>
</div>

<script>
  import type { WiresHandle } from '../gfx/wires';

  const canRender = () =>
    'gpu' in navigator || !!document.createElement('canvas').getContext('webgl2');
  const wantsPulses = () => document.body.dataset.background !== 'quiet';

  let handle: WiresHandle | null = null;
  let starting = false;

  // The canvas persists across navigations, so the wires start once per visit. Each page only
  // switches the resting pulses on or off.
  const start = async () => {
    if (handle) {
      handle.setPulses(wantsPulses());
      return;
    }
    const canvas = document.querySelector<HTMLCanvasElement>('canvas[data-wires]');
    if (!canvas || !canRender() || starting) return;
    starting = true;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    try {
      const [{ startWires }, { themeColorHex }] = await Promise.all([
        import('../gfx/wires'),
        import('../gfx/cssColor'),
      ]);
      const accent = themeColorHex('--color-accent', '#a9d5b5');
      handle = await startWires(canvas, { reducedMotion, accent, pulses: wantsPulses() });
      canvas.dataset.ready = '';
    } catch (error) {
      // The gradient stays. Nothing else to do.
      console.warn('Wire background disabled:', error);
    } finally {
      starting = false;
    }
  };

  const schedule = () => {
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(() => void start(), { timeout: 1500 });
    } else {
      setTimeout(() => void start(), 300);
    }
  };

  // The burst starts where the visitor clicked. A navigation by keyboard, or by the browser's
  // back button, has no recent click: then the activated link, if any, or the screen centre.
  let lastClick: { x: number; y: number; at: number } | null = null;
  window.addEventListener(
    'pointerdown',
    (e) => (lastClick = { x: e.clientX, y: e.clientY, at: performance.now() }),
    { capture: true, passive: true },
  );
  const burstCentre = (source: Element | undefined) => {
    if (lastClick && performance.now() - lastClick.at < 1500) return lastClick;
    const rect = source?.getBoundingClientRect();
    return rect ? { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 } : undefined;
  };

  document.addEventListener('astro:page-load', schedule);
  document.addEventListener('astro:before-preparation', (event) => {
    handle?.burst(burstCentre(event.sourceElement));
  });
</script>
