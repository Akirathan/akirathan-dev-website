---
import github from '@tabler/icons/outline/brand-github.svg?raw';

const year = new Date().getFullYear();
const repo = 'Akirathan/akirathan-dev-website';
const repoLabel = 'Source code';
---

<footer class="border-t border-white/10 bg-ink/40 text-sm text-subtle backdrop-blur-md">
  <div class="mx-auto flex w-full max-w-6xl flex-col items-center gap-4 px-4 py-8 text-center sm:px-6">
    <nav aria-label="Footer" class="flex flex-wrap justify-center gap-x-8 gap-y-2">
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a
        href={`https://github.com/${repo}`}
        rel="noopener"
        target="_blank"
        class="inline-flex items-center gap-2"
      >
        <span
          aria-hidden="true"
          class="size-4 shrink-0 [&>svg]:size-full [&>svg]:stroke-[1.75]"
          set:html={github}
        />
        {repoLabel}
      </a>
    </nav>
    <p class="flex flex-col gap-1 text-xs sm:flex-row sm:gap-2">
      <span>© {year} Pavel Marek</span>
      <span aria-hidden="true" class="hidden sm:inline">
        ·
      </span>
      <a href="/about#how-it-was-made">Written by me, built with Claude</a>
    </p>
  </div>
</footer>

<style>
  a {
    position: relative;
    transition: color 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  a:hover,
  a:focus-visible {
    color: var(--color-paper);
  }

  a span {
    transition: color 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  a:hover span,
  a:focus-visible span {
    color: var(--color-accent);
  }

  /* The trace: draws in from the left, retracts to the right. */
  a::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -0.3rem;
    height: 1px;
    background: var(--color-accent-dim);
    transform: scaleX(0);
    transform-origin: right;
  }

  a:hover::before,
  a:focus-visible::before {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* The pulse: one bright spot runs along the trace. */
  a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: calc(-0.3rem - 1px);
    width: 1.25rem;
    height: 3px;
    border-radius: 9999px;
    background: linear-gradient(90deg, transparent, var(--color-accent));
    box-shadow: 0 0 6px var(--color-accent);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    a::before {
      transition: transform 450ms cubic-bezier(0.65, 0, 0.35, 1);
    }

    a:hover::after,
    a:focus-visible::after {
      animation: footer-pulse 800ms cubic-bezier(0.4, 0, 0.2, 1) 100ms both;
    }
  }

  @keyframes footer-pulse {
    0% {
      left: 0;
      translate: -100% 0;
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
    100% {
      left: 100%;
      translate: -60% 0;
      opacity: 0;
    }
  }
</style>
