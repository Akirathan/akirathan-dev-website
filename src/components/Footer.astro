---
import github from '@tabler/icons/outline/brand-github.svg?raw';
import { lastCommit } from '../data/build';

const year = new Date().getFullYear();
const repo = 'Akirathan/akirathan-dev-website';
const repoLabel = 'Source code';
const status = 'Open to new roles';
const updated = lastCommit?.date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<footer class="border-t border-white/10 bg-ink/40 text-sm text-subtle backdrop-blur-md">
  <div class="mx-auto flex w-full max-w-6xl flex-col items-center gap-4 px-4 py-8 text-center sm:px-6">
    <a
      href="/contact"
      class="status inline-flex items-center gap-2 rounded-full border border-accent/25 bg-accent/5 px-3 py-1 text-xs text-accent"
    >
      <span aria-hidden="true" class="dot relative size-1.5 rounded-full bg-accent"></span>
      {status}
    </a>
    <nav aria-label="Footer" class="flex flex-wrap justify-center gap-x-8 gap-y-2">
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a
        href={`https://github.com/${repo}`}
        rel="noopener"
        target="_blank"
        class="inline-flex items-center gap-2"
      >
        <span
          aria-hidden="true"
          class="size-4 shrink-0 [&>svg]:size-full [&>svg]:stroke-[1.75]"
          set:html={github}
        />
        {repoLabel}
      </a>
    </nav>
    <div class="flex flex-col items-center gap-1.5">
      <p class="flex flex-col gap-1 text-xs sm:flex-row sm:gap-2">
        <span>© {year} Pavel Marek</span>
        <span aria-hidden="true" class="hidden sm:inline">
          ·
        </span>
        <a href="/about#how-it-was-made">Written by me, built with Claude</a>
      </p>
      {lastCommit && (
        <p class="flex justify-center gap-2 text-xs">
          <span>
            Updated <time datetime={lastCommit.date.toISOString()}>{updated}</time>
          </span>
          <span aria-hidden="true">·</span>
          <a
            href={`https://github.com/${repo}/commit/${lastCommit.hash}`}
            rel="noopener"
            target="_blank"
            class="font-mono"
            aria-label={`Commit ${lastCommit.shortHash} on GitHub`}
          >
            {lastCommit.shortHash}
          </a>
        </p>
      )}
    </div>
  </div>
</footer>

<style>
  a {
    position: relative;
    transition: color 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  a:hover,
  a:focus-visible {
    color: var(--color-paper);
  }

  .status {
    transition:
      color 300ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .status:hover,
  .status:focus-visible {
    border-color: color-mix(in oklab, var(--color-accent) 60%, transparent);
  }

  /* A soft ring grows from the dot and fades out. */
  .dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-accent);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .dot::after {
      animation: status-ring 3s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
  }

  @keyframes status-ring {
    0% {
      scale: 1;
      opacity: 0.5;
    }
    60%,
    100% {
      scale: 3;
      opacity: 0;
    }
  }

  a span {
    transition: color 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  a:hover span,
  a:focus-visible span {
    color: var(--color-accent);
  }

  /* The wire: draws in from the left, retracts to the right. */
  a:not(.status)::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -0.3rem;
    height: 1px;
    background: color-mix(in oklab, var(--color-accent) 80%, transparent);
    transform: scaleX(0);
    transform-origin: right;
  }

  a:not(.status):hover::before,
  a:not(.status):focus-visible::before {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* The pulse of Outline.astro, with a fixed dash length so that short labels get a visible
     dash. The run goes on past the end, so the dash is out of sight for part of the period. */
  @property --footer-pulse {
    syntax: '<length-percentage>';
    inherits: false;
    initial-value: 0%;
  }

  @keyframes footer-pulse {
    from {
      --footer-pulse: 0%;
    }
    to {
      --footer-pulse: calc(150% + 1rem);
    }
  }

  a:not(.status)::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: calc(-0.3rem - 0.5px);
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent calc(var(--footer-pulse) - 1rem),
      var(--color-paper) calc(var(--footer-pulse) - 1rem),
      var(--color-paper) var(--footer-pulse),
      transparent var(--footer-pulse)
    );
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    a:not(.status)::before {
      transition: transform 450ms cubic-bezier(0.65, 0, 0.35, 1);
    }

    a:not(.status):hover::after,
    a:not(.status):focus-visible::after {
      opacity: 1;
      animation: footer-pulse 1.6s linear infinite;
    }
  }
</style>
