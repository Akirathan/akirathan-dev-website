---
/**
 * A procedural CPU seen from above, tilting with the pointer. Decorative: reserve the space
 * with the `class` prop, nothing else is needed. Without a GPU the space stays empty.
 *
 * When the scene runs, the canvas dispatches `cpu:ready` with the `CpuHandle` as `detail`.
 */
import type { CpuOptions } from '../gfx/cpu';
import { attr, hooks } from '../dom';

interface Props {
  class?: string;
  text?: CpuOptions['text'];
}

const { class: className, text = ['Pavel Marek', 'akirathan.dev', 'Senior SW engineer'] } =
  Astro.props;
---

<div class:list={['relative', className]} aria-hidden="true">
  <canvas
    {...attr(hooks.cpuScene)}
    {...attr(hooks.cpuText, JSON.stringify(text))}
    class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-1000 data-ready:opacity-100"
  ></canvas>
</div>

<script>
  import type { CpuHandle } from '../gfx/cpu';
  import { hooks, selector, states } from '../dom';

  const canRender = () =>
    'gpu' in navigator || !!document.createElement('canvas').getContext('webgl2');

  let handles: CpuHandle[] = [];

  const start = async () => {
    const canvases = document.querySelectorAll<HTMLCanvasElement>(
      selector(hooks.cpuScene, 'canvas'),
    );
    if (canvases.length === 0 || !canRender()) return;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    try {
      const [{ startCpu }, { themeColorHex }] = await Promise.all([
        import('../gfx/cpu'),
        import('../gfx/cssColor'),
      ]);
      const headingFont =
        getComputedStyle(document.documentElement).getPropertyValue('--font-heading').trim() ||
        'sans-serif';
      try {
        await document.fonts.load(`800 118px ${headingFont}`);
      } catch {
        // The fallback font is fine for etched text.
      }
      for (const canvas of canvases) {
        const handle = await startCpu(canvas, {
          reducedMotion,
          accent: themeColorHex('--color-accent', '#a9d5b5'),
          headingFont,
          text: JSON.parse(canvas.getAttribute(hooks.cpuText) ?? '[""]'),
        });
        handles.push(handle);
        canvas.setAttribute(states.ready, '');
        canvas.dispatchEvent(new CustomEvent('cpu:ready', { detail: handle }));
      }
    } catch (error) {
      console.warn('CPU scene disabled:', error);
    }
  };

  const schedule = () => {
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(() => void start(), { timeout: 2000 });
    } else {
      setTimeout(() => void start(), 500);
    }
  };

  document.addEventListener('astro:page-load', schedule);
  document.addEventListener('astro:before-swap', () => {
    for (const handle of handles) handle.dispose();
    handles = [];
  });
</script>
