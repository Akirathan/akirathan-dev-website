---
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#about', label: 'About' },
  { href: '/skills', label: 'Skills' },
  { href: 'https://github.com/Akirathan', label: 'GitHub', external: true },
  { href: 'https://www.linkedin.com/in/pavel-marek-56a517140/', label: 'LinkedIn', external: true },
];
---

<header class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-5 sm:px-6">
  <a href="/" class="font-heading text-lg font-semibold tracking-tight hover:text-accent">
    akirathan<span class="text-accent">.dev</span>
  </a>
  <nav aria-label="Main">
    <ul class="flex items-center gap-5 text-sm text-muted">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class="transition-colors hover:text-paper"
            {...(l.external ? { target: '_blank', rel: 'noreferrer' } : {})}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
