---
/**
 * Shader page transition made of lanes, like the wires of the background. Hooks into Astro's
 * client-side navigation: the lanes cover the page before the swap and leave after it. Links
 * with `data-nav="back"` and browser back navigation sweep from the right; everything else
 * sweeps from the left.
 *
 * Without a GPU, or under `prefers-reduced-motion`, Astro's default transition is used.
 */
---

<canvas
  id="page-curtain"
  transition:persist
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 z-100 h-dvh w-screen"
  style="visibility: hidden"
></canvas>

<script>
  import type { PageCurtainHandle } from '../gfx/pageCurtain';
  import { cssColorToHex } from '../gfx/cssColor';

  const canRender = () =>
    'gpu' in navigator || !!document.createElement('canvas').getContext('webgl2');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let curtain: PageCurtainHandle | null = null;

  const init = async () => {
    const canvas = document.getElementById('page-curtain') as HTMLCanvasElement | null;
    if (!canvas || curtain) return;
    try {
      const { startPageCurtain } = await import('../gfx/pageCurtain');
      const styles = getComputedStyle(document.documentElement);
      const theme = (name: string, fallback: string) =>
        cssColorToHex(styles.getPropertyValue(name).trim(), fallback);
      curtain = await startPageCurtain(canvas, {
        color: theme('--color-ink', '#15171e'),
        lineColor: theme('--color-muted', '#a7a9b3'),
        pulseColor: theme('--color-accent', '#a9d5b5'),
      });
      // The curtain replaces Astro's default cross-fade.
      document.documentElement.dataset.curtain = '';
    } catch (error) {
      console.warn('Page curtain disabled:', error);
    }
  };

  if (canRender() && !reducedMotion) {
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(() => void init(), { timeout: 2500 });
    } else {
      setTimeout(() => void init(), 800);
    }

    document.addEventListener('astro:before-preparation', (event) => {
      if (!curtain) return;
      const back =
        event.direction === 'back' ||
        (event.sourceElement instanceof HTMLElement && event.sourceElement.dataset.nav === 'back');
      const load = event.loader;
      const handle = curtain;
      // Load the next page while the curtain closes; swap only when both are done.
      event.loader = async () => {
        await Promise.all([handle.cover(back ? -1 : 1), load()]);
      };
    });

    document.addEventListener('astro:after-swap', () => {
      if (!curtain) return;
      // The router replaces the attributes of <html>, so the flag must come back after each swap.
      document.documentElement.dataset.curtain = '';
      void curtain.reveal();
    });
  }
</script>
