---
import CpuScene from './CpuScene.astro';
import { contactItems, type ContactIcon, type ContactItem } from '../data/contact';
import mail from '@tabler/icons/outline/mail.svg?raw';
import github from '@tabler/icons/outline/brand-github.svg?raw';
import linkedin from '@tabler/icons/outline/brand-linkedin.svg?raw';
import languages from '@tabler/icons/outline/language.svg?raw';
import location from '@tabler/icons/outline/map-pin.svg?raw';
import timezone from '@tabler/icons/outline/clock.svg?raw';

/**
 * The contact items around a CPU seen from above. From the `lg` breakpoint, a wire runs from a
 * trace end of the CPU to each card; the card under the pointer (or, when idle, one card after
 * another) gets a pulse along its wire. Without a GPU, or on narrow screens, the cards stand on
 * their own.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const icons: Record<ContactIcon, string> = {
  mail,
  github,
  linkedin,
  languages,
  location,
  timezone,
};

const left = contactItems.filter((item) => item.side === 'left');
const right = contactItems.filter((item) => item.side === 'right');
const columns: [ContactItem[], 'left' | 'right'][] = [
  [left, 'left'],
  [right, 'right'],
];
---

<div
  data-contact-board
  data-wired-board
  data-wires-from="(min-width: 64rem)"
  class:list={[
    'group relative grid gap-6 lg:grid-cols-[1fr_auto_1fr] lg:items-center lg:gap-x-12 xl:gap-x-16',
    className,
  ]}
>
  <svg
    data-wires
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 hidden h-full w-full overflow-visible opacity-0 transition-opacity duration-1000 group-data-wired:opacity-100 lg:block"
  ></svg>

  <CpuScene
    view="top"
    class="mx-auto aspect-square w-full max-w-72 lg:col-start-2 lg:row-start-1 lg:w-[20rem] xl:w-[22rem] lg:max-w-none"
  />

  {columns.map(([items, side]) => (
    <ul
      class:list={[
        'grid gap-4 sm:grid-cols-2 lg:row-start-1 lg:grid-cols-1 lg:gap-6',
        side === 'left' ? 'lg:col-start-1' : 'lg:col-start-3',
      ]}
    >
      {items.map((item) => {
        const Tag = item.href ? 'a' : 'div';
        return (
          <li data-wire-side={side}>
            <Tag
              href={item.href}
              {...(item.external ? { target: '_blank', rel: 'noreferrer' } : {})}
              class:list={[
                'trace-border relative block rounded-xl border border-paper/10 bg-ink-soft/60 px-5 py-4 lg:px-4 xl:px-5 backdrop-blur-sm transition-colors duration-300',
                side === 'left' && 'lg:text-right',
              ]}
            >
              <span
                class:list={[
                  'flex items-center gap-2 text-xs font-medium tracking-widest text-accent uppercase',
                  side === 'left' && 'lg:flex-row-reverse',
                ]}
              >
                <span
                  aria-hidden="true"
                  class="icon size-[1.125rem] shrink-0 text-accent-dim transition-colors duration-300 [&>svg]:size-full [&>svg]:stroke-[1.75]"
                  set:html={icons[item.icon]}
                />
                {item.label}
              </span>
              {[item.value].flat().map((line, i) => (
                <span class:list={['block break-words text-paper', i === 0 && 'mt-1']}>{line}</span>
              ))}
            </Tag>
          </li>
        );
      })}
    </ul>
  ))}
</div>

<style>
  [data-contact-board] li > :hover,
  [data-contact-board] li[data-on] > * {
    border-color: color-mix(in oklab, var(--color-accent) 60%, transparent);
  }

  [data-contact-board] li > :hover .icon,
  [data-contact-board] li[data-on] .icon {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-contact-board] li > :hover::before,
    [data-contact-board] li[data-on] > *::before {
      animation: trace 1.4s cubic-bezier(0.45, 0, 0.3, 1);
    }
  }
</style>

<script>
  import { startWiredBoard } from '../gfx/wiredBoard';

  let dispose: (() => void) | null = null;

  document.addEventListener('astro:page-load', () => {
    const board = document.querySelector<HTMLElement>('[data-contact-board]');
    if (board) {
      dispose = startWiredBoard(board);
    }
  });

  document.addEventListener('astro:before-swap', () => {
    dispose?.();
    dispose = null;
  });
</script>
