---
import { skillHref, type Skill } from '../data/skills';

/**
 * A skill keyword as a chip. Links to its place on /skills, or, on /skills itself, is the
 * link target (`target` prop) and highlights when addressed by the URL fragment.
 */
interface Props {
  skill: Skill;
  target?: boolean;
  size?: 'sm' | 'md';
}

const { skill, target = false, size = 'sm' } = Astro.props;
const sizeClass = size === 'md' ? 'px-4 py-1.5 text-sm' : 'px-3 py-1 text-xs';
---

{target ? (
  <span
    id={skill.slug}
    class:list={[
      'inline-block scroll-mt-28 rounded-full border border-paper/15 text-paper/85 transition-colors target:border-accent target:bg-accent/15 target:text-paper',
      sizeClass,
    ]}
  >
    {skill.label}
  </span>
) : (
  <a
    href={skillHref(skill)}
    class:list={[
      'inline-block rounded-full border border-paper/15 text-muted transition-colors hover:border-accent/60 hover:text-paper',
      sizeClass,
    ]}
  >
    {skill.label}
  </a>
)}
