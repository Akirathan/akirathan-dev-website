---
import { Image } from 'astro:assets';
import { skillArticleHref, skillHref, skillIcon, type Skill } from '../data/skills';
import { hasArticle } from '../data/skillContent';

/**
 * A skill keyword as a small chip, with the skill's icon when one exists. Links to the skill's
 * note when `src/content/skills/<slug>.mdx` exists, otherwise to its card on /skills.
 */
interface Props {
  skill: Skill;
  size?: 'sm' | 'md';
}

const { skill, size = 'sm' } = Astro.props;
const article = await hasArticle(skill);
const icon = skillIcon(skill);

const sizes = {
  sm: 'px-3 py-1 text-xs',
  md: 'px-4 py-1.5 text-sm',
};
const iconClass = size === 'md' ? '-ml-1.5 size-5' : '-ml-1 size-4';
const tone = article
  ? 'border-paper/25 text-paper/90 hover:border-accent hover:bg-accent/10 hover:text-paper'
  : 'border-paper/15 text-muted hover:border-accent/60 hover:text-paper';
---

<a
  href={article ? skillArticleHref(skill) : skillHref(skill)}
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full border transition-colors',
    sizes[size],
    tone,
  ]}
>
  {icon && <Image src={icon} alt="" width={40} height={40} class={iconClass} />}
  {skill.label}
  {article && (
    <span aria-hidden="true" class="-mr-1 text-accent">
      →
    </span>
  )}
</a>
