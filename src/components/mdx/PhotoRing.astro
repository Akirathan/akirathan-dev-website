---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A ring of photos to spin: a prism with three photos, a carousel with more.
 *
 * The page renders a plain horizontal strip of the photos first (no JavaScript needed). When
 * the browser can, the Three.js ring (src/gfx/photoRing.ts) fades in over it: drag to spin,
 * it snaps to the nearest photo, and it turns slowly by itself when left alone. Under
 * `prefers-reduced-motion` nothing moves by itself; dragging works.
 *
 * Usage in .mdx:
 *   import PhotoRing from '../../components/mdx/PhotoRing.astro';
 *   import a from '../../assets/x/a.jpg';
 *   <PhotoRing images={[a, b, c]} alts={['...', '...', '...']} />
 */
interface Props {
  images: ImageMetadata[];
  alts: string[];
  /** CSS length for the height of the gallery. */
  height?: string;
}

const { images, alts, height = 'min(22rem, 70vw)' } = Astro.props;

if (images.length < 2) throw new Error('PhotoRing needs at least two images.');
if (alts.length !== images.length) throw new Error('PhotoRing: one alt text per image.');

// All panels share the aspect ratio of the first photo.
const aspect = images[0]!.width / images[0]!.height;
const faces = await Promise.all(images.map((src) => getImage({ src, width: 960, format: 'webp' })));
const faceUrls = faces.map((f) => f.src);
---

<figure class="photo-ring not-prose my-12" style={`--h: ${height}`}>
  <div class="photo-ring-scene">
    <ul class="photo-ring-strip">
      {faces.map((face, i) => (
        <li>
          <img src={face.src} {...face.attributes} alt={alts[i]} loading="lazy" decoding="async" />
        </li>
      ))}
    </ul>
    <canvas
      class="photo-ring-canvas"
      data-photo-ring
      data-faces={JSON.stringify(faceUrls)}
      data-aspect={aspect}
      role="img"
      aria-label={`Photo ring: ${alts.join('; ')}. Drag to spin.`}
    ></canvas>
  </div>
</figure>

<script>
  const canRender = () =>
    'gpu' in navigator || !!document.createElement('canvas').getContext('webgl2');

  const canvases = document.querySelectorAll<HTMLCanvasElement>('canvas[data-photo-ring]');
  if (canvases.length > 0 && canRender()) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const start = async () => {
      const { startPhotoRing } = await import('../../gfx/photoRing');
      for (const canvas of canvases) {
        try {
          const faces = JSON.parse(canvas.dataset.faces ?? '[]') as string[];
          const aspect = Number(canvas.dataset.aspect) || 4 / 3;
          await startPhotoRing(canvas, { faces, aspect, autoRotate: !reducedMotion });
          canvas.closest('.photo-ring-scene')?.setAttribute('data-ready', '');
        } catch (error) {
          // The photo strip stays.
          console.warn('Photo ring disabled:', error);
        }
      }
    };
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(() => void start(), { timeout: 2000 });
    } else {
      setTimeout(() => void start(), 500);
    }
  }
</script>

<style>
  .photo-ring-scene {
    position: relative;
    height: var(--h);
  }

  /* Fallback and first paint: a scrollable strip of the photos. */
  .photo-ring-strip {
    display: flex;
    gap: 0.75rem;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    transition: opacity 600ms ease;
  }
  .photo-ring-strip li {
    flex: 0 0 auto;
    height: 100%;
    scroll-snap-align: center;
  }
  .photo-ring-strip img {
    height: 100%;
    width: auto;
    border-radius: 0.75rem;
  }

  .photo-ring-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 600ms ease;
    /* Horizontal drags spin the ring; vertical swipes still scroll the page on touch. */
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  .photo-ring-scene[data-ready] .photo-ring-canvas {
    opacity: 1;
  }
  .photo-ring-scene[data-ready] .photo-ring-strip {
    opacity: 0;
    pointer-events: none;
  }
</style>
