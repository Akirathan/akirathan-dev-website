---
/**
 * A 0-10 meter of the author's AI hype, from an angry mob (0) to a moon rocket (10).
 *
 * Usage in .mdx:
 *   import HypeMeter from '@/components/mdx/HypeMeter.astro';
 *   <HypeMeter value={7} />
 */
interface Props {
  value: number;
  label?: string;
  low?: string;
  high?: string;
}

const { value, label = 'AI hype meter', low = 'Anti AI', high = 'Overhyped' } = Astro.props;
const level = Math.min(10, Math.max(0, Math.round(value)));
---

<figure
  role="meter"
  aria-label={label}
  aria-valuemin="0"
  aria-valuemax="10"
  aria-valuenow={level}
  aria-valuetext={`${level} of 10, on a scale from ${low} to ${high}`}
  class="not-prose my-8 rounded-xl border border-paper/15 px-5 py-4"
>
  <figcaption class="mb-3 font-heading text-xs font-semibold tracking-widest text-paper/70 uppercase">
    {label}
  </figcaption>

  <div aria-hidden="true" class="flex items-center gap-3">
    <svg
      viewBox="0 0 24 24"
      class="size-7 shrink-0 text-subtle"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <title>{low}: grab the pitchforks</title>
      <path d="M12 3v19M6 3v4.5c0 2.5 2.5 3.5 6 3.5s6-1 6-3.5V3" />
    </svg>

    <div class="relative flex-1">
      <div class="flex gap-1">
        {Array.from({ length: 10 }, (_, i) => (
          <span
            class:list={['h-3 flex-1 rounded-[3px]', i < level ? 'hype-on' : 'bg-paper/12']}
            style={`--i: ${i}`}
          />
        ))}
      </div>
      <span
        class="hype-pin absolute top-full mt-1.5 -translate-x-1/2 text-xs whitespace-nowrap text-accent"
        style={`left: calc(${level * 10}% - 0.125rem)`}
      >
        ▲ me, {level}/10
      </span>
    </div>

    <svg
      viewBox="0 0 24 24"
      class="size-7 shrink-0 text-muted"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <title>{high}: to the moon</title>
      <path d="M12 2c3 2.5 4.5 6 4.5 10v4h-9v-4c0-4 1.5-7.5 4.5-10z" />
      <circle cx="12" cy="9" r="1.5" />
      <path d="M7.5 12.5 5 15.5v3l2.5-1.5M16.5 12.5l2.5 3v3l-2.5-1.5M10 19c0 1.5 1 2.5 2 3 1-.5 2-1.5 2-3" />
    </svg>
  </div>

  <div aria-hidden="true" class="mt-7 flex justify-between text-xs text-muted">
    <span>{low}</span>
    <span>{high}</span>
  </div>
</figure>

<style>
  @keyframes hype-fill {
    from {
      background-color: color-mix(in oklch, var(--color-paper) 12%, transparent);
      scale: 1 0.4;
    }
  }

  @keyframes hype-pin {
    from {
      opacity: 0;
      translate: 0 0.5rem;
    }
  }

  .hype-on {
    background-color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hype-on {
      animation: hype-fill 320ms cubic-bezier(0.2, 0.7, 0.3, 1) both;
      animation-delay: calc(300ms + var(--i) * 70ms);
    }

    .hype-pin {
      animation: hype-pin 400ms cubic-bezier(0.2, 0.7, 0.3, 1) 1100ms both;
    }
  }
</style>
