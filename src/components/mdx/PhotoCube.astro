---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A photo cube with three photos on opposite face pairs.
 *
 * The page renders a CSS 3D cube first (slow rotation, no JavaScript). When the browser can,
 * a Three.js cube (src/gfx/photoCube.ts) takes its place: drag to turn it, with inertia and a
 * slow idle rotation. Under `prefers-reduced-motion` nothing turns by itself; dragging works.
 *
 * Usage in .mdx:
 *   import PhotoCube from '../../components/mdx/PhotoCube.astro';
 *   import a from '../../assets/x/a.jpg';
 *   <PhotoCube images={[a, b, c]} alts={['...', '...', '...']} />
 */
interface Props {
  images: [ImageMetadata, ImageMetadata, ImageMetadata];
  alts: [string, string, string];
  /** CSS length for the cube edge. */
  size?: string;
  /** Seconds for one full turn of the CSS fallback. */
  period?: number;
}

const { images, alts, size = 'min(18rem, 60vw)', period = 28 } = Astro.props;

const faces = await Promise.all(
  images.map((src) => getImage({ src, width: 720, height: 720, fit: 'cover', format: 'webp' })),
);
const faceUrls = faces.map((f) => f.src);

// CSS face order: front, back, right, left, top, bottom. Opposite faces share a photo.
const order = [0, 0, 1, 1, 2, 2] as const;
---

<figure
  class="photo-cube-figure not-prose my-12 flex justify-center"
  style={`--size: ${size}; --period: ${period}s`}
>
  <div class="photo-cube-scene">
    <div class="photo-cube">
      {order.map((i, face) => (
        <img
          class="photo-cube-face"
          data-face={face}
          src={faces[i]!.src}
          {...faces[i]!.attributes}
          alt={alts[i]}
          loading="lazy"
          decoding="async"
        />
      ))}
    </div>
    <canvas
      class="photo-cube-canvas"
      data-photo-cube
      data-faces={JSON.stringify(faceUrls)}
      aria-label={`Photo cube: ${alts.join('; ')}. Drag to turn.`}
      role="img"
    ></canvas>
  </div>
</figure>

<script>
  const canRender = () =>
    'gpu' in navigator || !!document.createElement('canvas').getContext('webgl2');

  const canvases = document.querySelectorAll<HTMLCanvasElement>('canvas[data-photo-cube]');
  if (canvases.length > 0 && canRender()) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const start = async () => {
      const { startPhotoCube } = await import('../../gfx/photoCube');
      for (const canvas of canvases) {
        try {
          const faces = JSON.parse(canvas.dataset.faces ?? '[]') as [string, string, string];
          await startPhotoCube(canvas, { faces, autoRotate: !reducedMotion });
          canvas.closest('.photo-cube-scene')?.setAttribute('data-ready', '');
        } catch (error) {
          // The CSS cube stays.
          console.warn('Photo cube disabled:', error);
        }
      }
    };
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(() => void start(), { timeout: 2000 });
    } else {
      setTimeout(() => void start(), 500);
    }
  }
</script>

<style>
  .photo-cube-scene {
    position: relative;
    width: var(--size);
    height: var(--size);
    perspective: calc(var(--size) * 3.2);
    /* The turned cube is drawn outside its box: keep it off the text above and below. */
    margin-block: calc(var(--size) * 0.25);
  }

  /* The Three.js canvas is larger than the cube so that corners are never clipped. */
  .photo-cube-canvas {
    position: absolute;
    inset: calc(var(--size) * -0.3);
    width: calc(var(--size) * 1.6);
    height: calc(var(--size) * 1.6);
    opacity: 0;
    transition: opacity 600ms ease;
    /* Horizontal drags turn the cube; vertical swipes still scroll the page on touch. */
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  .photo-cube-scene[data-ready] .photo-cube-canvas {
    opacity: 1;
  }

  .photo-cube-scene[data-ready] .photo-cube {
    opacity: 0;
    transition: opacity 600ms ease;
    pointer-events: none;
  }

  .photo-cube {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    /* A still, pleasant angle for reduced motion and as the animation start. */
    transform: rotateX(-18deg) rotateY(32deg);
    animation: photo-cube-turn var(--period) linear infinite;
  }

  .photo-cube-face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0.75rem;
    backface-visibility: hidden;
    box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--color-paper) 15%, transparent);
    --half: calc(var(--size) / 2);
  }

  .photo-cube-face[data-face='0'] {
    transform: translateZ(var(--half));
  }
  .photo-cube-face[data-face='1'] {
    transform: rotateY(180deg) translateZ(var(--half));
  }
  .photo-cube-face[data-face='2'] {
    transform: rotateY(90deg) translateZ(var(--half));
  }
  .photo-cube-face[data-face='3'] {
    transform: rotateY(-90deg) translateZ(var(--half));
  }
  .photo-cube-face[data-face='4'] {
    transform: rotateX(90deg) translateZ(var(--half));
  }
  .photo-cube-face[data-face='5'] {
    transform: rotateX(-90deg) translateZ(var(--half));
  }

  @keyframes photo-cube-turn {
    from {
      transform: rotateX(-18deg) rotateY(0deg);
    }
    to {
      transform: rotateX(-18deg) rotateY(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-cube {
      animation: none;
    }
  }
</style>
