---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/portrait.jpg';
import Card from '../components/Card.astro';
import CpuScene from '../components/CpuScene.astro';
import SkillChip from '../components/SkillChip.astro';
import { skills } from '../data/skills';
import { attr, hooks } from '../dom';

const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;

const experience = (await getCollection('experience')).sort(byOrder);
const mainJobs = experience.filter((e) => !e.data.minor);
const minorJobs = experience.filter((e) => e.data.minor);
const topics = (await getCollection('topics')).sort(byOrder);
---

<BaseLayout animatedBackground>
  <!-- Hero -->
  <section class="mx-auto grid min-h-[70dvh] w-full max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1fr_auto]">
    <div>
      <p class="text-sm font-medium tracking-widest text-accent uppercase">Pavel Marek · Brno</p>
      <h1 class="mt-4 max-w-4xl text-5xl font-bold tracking-tight text-balance sm:text-7xl">
        I make languages fast and businesses run.
      </h1>
      <ul class="mt-8 max-w-2xl space-y-2 text-lg text-paper/80">
        <li>Senior software engineer: compilers, interpreters, and runtime internals.</li>
        <li>JVM, GraalVM Native Image, and the Truffle ecosystem.</li>
        <li>Co-founder &amp; CTO of a plant showroom and e-shop.</li>
      </ul>
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="#work"
          class="rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:bg-paper"
        >
          See my work
        </a>
        <a
          href="#about"
          class="rounded-full border border-paper/20 px-5 py-2.5 text-sm font-semibold transition-colors hover:border-accent hover:text-accent"
        >
          More about me
        </a>
      </div>
    </div>
    <!-- The studio black of the photo melts into the page; the mask hides its edges. -->
    <Image
      src={portrait}
      alt="Pavel Marek"
      widths={[320, 480, 640, 960]}
      sizes="(min-width: 1024px) 22rem, 16rem"
      class="row-start-1 w-64 justify-self-center [mask-image:radial-gradient(ellipse_60%_55%_at_50%_42%,black_55%,transparent_100%)] lg:row-start-auto lg:w-[22rem]"
      loading="eager"
      fetchpriority="high"
    />
  </section>

  <!-- Work: the heading is printed on the CPU lid, and a wire runs from the CPU to each job. -->
  <section id="work" class="mx-auto w-full max-w-6xl scroll-mt-24 px-4 py-16 sm:px-6">
    <div
      {...attr(hooks.wiredBoard)}
      {...attr(hooks.wiresFrom, '(min-width: 48rem)')}
      class="group relative"
    >
      <svg
        {...attr(hooks.boardWires)}
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 hidden h-full w-full overflow-visible opacity-0 transition-opacity duration-1000 group-data-wired:opacity-100 md:block"
      ></svg>
      <div class="relative mx-auto aspect-square w-44 md:w-52">
        <!-- Without a GPU the heading shows in place of the chip; with one it only fades from
             view and stays in the accessibility tree. -->
        <h2 class="absolute inset-0 grid place-items-center text-3xl font-bold tracking-tight transition-opacity duration-1000 group-has-[[data-ready]]:opacity-0 sm:text-4xl">
          Work
        </h2>
        <CpuScene text={['Work']} class="h-full w-full" />
      </div>
      <div class="mt-6 grid gap-5 md:mt-14 md:grid-cols-3">
        {mainJobs.map((job) => (
          <Card
            wireSide="bottom"
            href={`/work/${job.id}`}
            eyebrow={job.data.period}
            title={job.data.company}
            meta={job.data.role}
            bullets={job.data.summary}
          />
        ))}
      </div>
    </div>
    {minorJobs.length > 0 && (
      <p class="reveal mt-6 text-sm text-muted">
        Earlier:{' '}
        {minorJobs.map((job, i) => (
          <>
            <a
              href={`/work/${job.id}`}
              class="underline-offset-4 hover:text-accent hover:underline"
            >
              {job.data.role} at {job.data.company}
            </a>{' '}
            ({job.data.period}){i < minorJobs.length - 1 ? ', ' : '.'}
          </>
        ))}
      </p>
    )}
  </section>

  <!-- Skills -->
  <section id="skills" class="mx-auto w-full max-w-6xl scroll-mt-24 px-4 py-16 sm:px-6">
    <div class="reveal flex flex-wrap items-end justify-between gap-4">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Skills in keywords</h2>
      <a href="/skills" class="text-sm font-medium text-accent hover:underline">
        With details →
      </a>
    </div>
    <ul class="reveal mt-8 flex flex-wrap gap-2">
      {skills.map((skill) => (
        <li>
          <SkillChip skill={skill} size="md" />
        </li>
      ))}
    </ul>
  </section>

  <!-- About -->
  <section id="about" class="mx-auto w-full max-w-6xl scroll-mt-24 px-4 py-16 sm:px-6">
    <h2 class="reveal text-3xl font-bold tracking-tight sm:text-4xl">About me</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {topics.map((topic) => (
        <Card
          href={`/${topic.id}`}
          title={topic.data.title}
          meta={topic.data.tagline}
          bullets={topic.data.summary}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  import { hooks, selector } from '../dom';
  import { startWiredBoard } from '../gfx/wiredBoard';

  let dispose: (() => void) | null = null;

  document.addEventListener('astro:page-load', () => {
    const board = document.querySelector<HTMLElement>(selector(hooks.wiredBoard));
    if (board) {
      dispose = startWiredBoard(board);
    }
  });

  document.addEventListener('astro:before-swap', () => {
    dispose?.();
    dispose = null;
  });
</script>
