---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import SkillChip from '../../components/SkillChip.astro';
import { skillByLabel } from '../../data/skills';

export async function getStaticPaths() {
  const entries = await getCollection('experience');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { company, role, period, location, tags, links, summary } = entry.data;
// Throws on an unknown tag, so a typo fails the build instead of producing a dead link.
const skills = tags.map(skillByLabel);
---

<ArticleLayout
  title={company}
  description={summary[0] ?? `${role} at ${company}`}
  eyebrow={period}
  meta={`${role} · ${location}`}
  backHref="/#work"
  backLabel="All work"
>
  <Fragment slot="header">
    {skills.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-2">
        {skills.map((skill) => (
          <li>
            <SkillChip skill={skill} />
          </li>
        ))}
      </ul>
    )}
    {links.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-4 text-sm">
        {links.map((l) => (
          <li>
            <a href={l.url} target="_blank" rel="noreferrer" class="text-accent hover:underline">
              {l.label} ↗
            </a>
          </li>
        ))}
      </ul>
    )}
  </Fragment>
  <Content />
</ArticleLayout>
