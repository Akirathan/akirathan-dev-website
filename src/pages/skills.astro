---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillCard from '../components/SkillCard.astro';
import { skillCategories } from '../data/skills';
import { usedAtBySkill } from '../data/skillContent';

// Which work entries mention each skill, for the "used at" line in each card.
const usedAt = await usedAtBySkill();
---

<BaseLayout
  title="Skills in keywords · Pavel Marek"
  description="The skills of Pavel Marek as keywords: languages, compilers and runtimes, web, infrastructure, and AI tooling."
>
  <section class="mx-auto w-full max-w-5xl px-4 py-10 sm:px-6 sm:py-16">
    <a href="/" data-nav="back" class="text-sm text-muted transition-colors hover:text-accent">
      ← Home
    </a>
    <h1 class="mt-6 text-4xl font-bold tracking-tight sm:text-5xl">Skills in keywords</h1>
    <p class="mt-3 max-w-2xl text-muted">
      The short version, for scanning. Each keyword lists the work where I used it. A chip with an
      arrow opens a longer note.
    </p>

    <div class="mt-12 space-y-12">
      {skillCategories.map((category) => (
        <section>
          <h2 class="category-title text-center text-3xl font-semibold text-accent">
            {category.title}
          </h2>
          <ul class="mt-6 grid auto-rows-fr gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {category.skills.map((skill) => (
              <li class="skill-item">
                <SkillCard skill={skill} usedAt={usedAt.get(skill.slug) ?? []} />
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  let observer: IntersectionObserver | undefined;

  document.addEventListener('astro:page-load', () => {
    const items = document.querySelectorAll('.skill-item');
    if (items.length === 0) {
      return;
    }
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.setAttribute('data-inview', '');
            observer?.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );
    for (const item of items) {
      observer.observe(item);
    }
  });

  document.addEventListener('astro:before-swap', () => {
    observer?.disconnect();
    observer = undefined;
  });
</script>

<style>
  /* The line under a category title grows from the centre as the title scrolls into view. */
  .category-title::after {
    content: '';
    display: block;
    width: 6rem;
    height: 2px;
    margin: 0.75rem auto 0;
    border-radius: 9999px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
  }

  /* Cards rise into place row by row; `--col` delays each column a little (also the meter). */
  .skill-item {
    --col: 0;
  }

  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .skill-item:nth-child(2n + 2) {
      --col: 1;
    }
  }

  @media (min-width: 64rem) {
    .skill-item:nth-child(3n + 2) {
      --col: 1;
    }

    .skill-item:nth-child(3n + 3) {
      --col: 2;
    }
  }

  @keyframes line-grow {
    from {
      scale: 0 1;
      opacity: 0;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 2rem;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .category-title::after {
        animation: line-grow linear both;
        animation-timeline: view();
        animation-range: entry 100% cover 35%;
      }
    }
  }

  /* Plays when the script below marks the item with `data-inview`. */
  @media (prefers-reduced-motion: no-preference) and (scripting: enabled) {
    .skill-item {
      animation: rise 400ms cubic-bezier(0.2, 0.7, 0.3, 1) both paused;
      animation-delay: calc(var(--col) * 90ms);
    }

    .skill-item[data-inview] {
      animation-play-state: running;
    }
  }
</style>
